{
  "meta": {
    "app_name": "finance-sys",
    "env": "dev",
    "timezone": "Asia/Shanghai",
    "config_version": 14
  },
  "service": {
    "http": {
      "host": "0.0.0.0",
      "port": 18081,
      "port_test": 18080,
      "api_prefix": "/api/v1",
      "read_timeout_ms": 30000,
      "write_timeout_ms": 900000,
      "idle_timeout_ms": 60000,
      "shutdown_timeout_seconds": 20,
      "max_header_bytes": 1048576,
      "cors": {
        "enabled": true,
        "allow_origins": [
          "http://localhost:3000"
        ]
      }
    }
  },
  "nacos_client": {
    "poll_interval_seconds": 30,
    "cache_last_good_config": true,
    "cache_dir": "./configs/.cache",
    "write_config_snapshot_to_db": true
  },
  "security": {
    "auth": {
      "enabled": false,
      "static_tokens": [
        "dev-token"
      ],
      "header_name": "Authorization",
      "token_prefix": "Bearer "
    }
  },
  "logging": {
    "level": "INFO"
  },
  "database": {
    "driver": "mysql",
    "dsn": "expert_trade:change_me@tcp(localhost:3306)/expert_trade?parseTime=true&multiStatements=true&charset=utf8mb4",
    "max_open_conns": 20,
    "max_idle_conns": 10,
    "conn_max_lifetime_minutes": 30,
    "conn_max_idle_time_minutes": 10
  },
  "database_test": {
    "driver": "mysql",
    "dsn": "expert_trade:change_me@tcp(localhost:3306)/expert_trade_test?parseTime=true&multiStatements=true&charset=utf8mb4",
    "max_open_conns": 20,
    "max_idle_conns": 10,
    "conn_max_lifetime_minutes": 30,
    "conn_max_idle_time_minutes": 10
  },
  "processing": {
    "ocr_max_concurrency": 2,
    "llm_max_concurrency": 20
  },
  "document": {
    "api_upload_enabled": true,
    "auto_analyze_upload": true,
    "allowed_extensions": [
      ".pdf",
      ".doc",
      ".docx",
      ".txt",
      ".md",
      ".csv"
    ],
    "max_file_size_mb": 50,
    "sha256_dedup": true,
    "source_defaults": {
      "author": "",
      "institution": ""
    },
    "chunking": {
      "enabled": true,
      "target_chars": 1000,
      "overlap_chars": 120
    },
    "pdf_ocr": {
      "command": "tools/guziyuan_pdf_ocr_tool/ocr_pdf.bat",
      "args": [
        "{input}",
        "--stdout"
      ],
      "min_text_chars": 80,
      "timeout_ms": 120000,
      "treat_exit_code_one_as_ok": true
    }
  },
  "external_documents": {
    "openlist": {
      "enabled": false,
      "base_url": "http://127.0.0.1:5244",
      "username": "",
      "password": "",
      "root_path": "/我的资源/游资大V复盘文章汇总2026",
      "institution": "个人",
      "request_timeout_ms": 120000,
      "scan_lookback_days": 14
    }
  },
  "llm": {
    "enabled": true,
    "provider": "openai_compatible",
    "endpoint": "http://127.0.0.1:11434/v1/chat/completions",
    "api_key": "",
    "model": "qwen2.5:14b-instruct",
    "timeout_ms": 240000,
    "max_retries": 2,
    "extra_headers": {
      "X-Client-Name": "finance-sys-agent",
      "X-Request-Source": "nacos-config"
    }
  },
  "agent": {
    "enabled": false,
    "mode": "primary",
    "endpoint": "http://127.0.0.1:8108/v1/resolve-document",
    "health_endpoint": "http://127.0.0.1:8108/healthz",
    "internal_api_base_url": "http://127.0.0.1:18081",
    "tushare": {
      "enabled": false,
      "token": "",
      "endpoint": "https://api.tushare.pro",
      "timeout_ms": 3000
    },
    "observation": {
      "enabled": true,
      "persist_success": true,
      "persist_failure": true,
      "persist_tool_traces": true,
      "shadow_sample_rate": 1.0,
      "max_targets_per_run": 100,
      "max_json_bytes": 65535,
      "retention_days": 90
    },
    "timeout_ms": 300000,
    "max_retries": 1,
    "schema_version": "agent.resolve_document.response.v1",
    "auth": {
      "enabled": false,
      "header_name": "X-Agent-Token",
      "static_token": ""
    },
    "allow_legacy_llm_fallback": false
  },
  "market_data": {
    "enabled": false,
    "provider": "tushare",
    "tushare": {
      "enabled": false,
      "sdk_package": "github.com/yushikuann/go-tushare-sdk/client",
      "tokens": [
        {
          "alias": "primary",
          "token": "",
          "enabled": false,
          "weight": 1
        },
        {
          "alias": "backup",
          "token": "",
          "enabled": false,
          "weight": 1
        }
      ],
      "timeout_ms": 10000,
      "max_retries": 2,
      "token_cooldown_ms": 60000
    },
    "async_worker": {
      "enabled": false,
      "poll_interval_ms": 1000,
      "claim_timeout_ms": 300000,
      "max_concurrent_runs": 1,
      "batch_size": 500
    },
    "security_master": {
      "enabled": false,
      "stock_fields": [
        "ts_code", "symbol", "name", "area", "industry", "fullname", "market", "exchange", "list_status", "list_date", "delist_date"
      ],
      "etf_fields": [
        "ts_code", "csname", "cname", "extname", "index_code", "index_name", "setup_date", "list_date", "list_status", "exchange"
      ],
      "sector_fields": [
        "ts_code", "trade_date", "name", "idx_type", "level"
      ]
    },
    "stock_daily": {
      "enabled": false,
      "sync_asset_types": [
        "STOCK",
        "ETF",
        "SECTOR"
      ],
      "fields": [
        "ts_code",
        "trade_date",
        "open",
        "high",
        "low",
        "close",
        "pre_close",
        "change",
        "pct_chg",
        "vol",
        "amount"
      ],
      "sector_fields": [
        "ts_code", "trade_date", "open", "high", "low", "close", "pct_change", "vol", "amount", "swing", "turnover_rate"
      ],
      "preserve_raw_units": true,
      "store_raw_content": true,
      "missing_item_mark_enabled": true
    }
  },
  "evaluation": {
    "enabled": false,
    "recommendation_performance": {
      "enabled": false,
      "windows": [
        5,
        10,
        30,
        90
      ],
      "quote_source": "TUSHARE",
      "entry_price_rule": "NEXT_TRADE_OPEN",
      "base_price_rule": "RECOMMEND_DATE_CLOSE_OR_NEXT_CLOSE",
      "win_threshold_ratio": 0,
      "min_quote_coverage_ratio": 1,
      "calc_version": "rec-performance-v3-sector",
      "async_worker": {
        "enabled": false,
        "poll_interval_ms": 1000,
        "claim_timeout_ms": 300000,
        "max_concurrent_runs": 1,
        "batch_size": 500
      },
      "ranking": {
        "default_window_days": 30,
        "default_min_sample_count": 5,
        "default_sort": "win_rate"
      }
    }
  },
  "scheduler": {
    "enabled": false,
    "poll_interval_ms": 1000,
    "claim_timeout_ms": 28800000,
    "security_master_refresh": {
      "enabled": false,
      "hour": 1,
      "minute": 0
    },
    "stock_daily_previous_day": {
      "enabled": false,
      "hour": 2,
      "minute": 0
    },
    "recommendation_evaluation_recent": {
      "enabled": false,
      "hour": 4,
      "minute": 0,
      "lookback_days": 90
    },
    "openlist_document_ingestion": {
      "enabled": false,
      "minute": 15
    }
  },
  "trading": {
    "enabled": false,
    "environment": "SIMULATION",
    "provider": "EASTMONEY_GM",
    "allow_live": false,
    "kill_switch": true,
    "agent": {
      "enabled": false,
      "endpoint": "http://127.0.0.1:8110/internal/v1/trading-agent/runs",
      "health_endpoint": "http://127.0.0.1:8110/healthz",
      "timeout_ms": 30000,
      "max_retries": 1,
      "schema_version": "trading-intent/v2",
      "internal_token": ""
    },
    "decision": {
      "provider": "DETERMINISTIC",
      "strategy_name": "blogger_follow_v1",
      "strategy_version": "1.0.0",
      "tool_contract_version": "trading-tools/v2",
      "min_recommendation_confidence": 0.65,
      "min_blogger_sample_count": 10,
      "min_blogger_win_rate": 0.55,
      "max_candidates_per_run": 20,
      "max_intents_per_run": 5
    },
    "risk": {
      "version": "risk-v1",
      "allowed_asset_types": ["STOCK", "ETF"],
      "allowed_markets": ["SH", "SZ"],
      "allowed_boards": ["SH_MAIN"],
      "allowed_sides": ["BUY", "SELL"],
      "trading_rule_version": "cn-equity-board-rules-2026-v1",
      "exclude_no_price_limit_period": true,
      "max_total_position_ratio": 0.60,
      "max_symbol_position_ratio": 0.10,
      "max_single_order_ratio": 0.05,
      "max_position_count": 10,
      "max_new_orders_per_day": 20,
      "max_daily_turnover_ratio": 0.30,
      "daily_loss_kill_ratio": 0.03,
      "max_price_deviation_ratio": 0.02,
      "min_cash_reserve_ratio": 0.20,
      "intent_cooldown_trade_days": 5,
      "max_snapshot_age_seconds": 15
    },
    "execution": {
      "default_order_type": "LIMIT",
      "allow_market_order": false,
      "command_poll_interval_ms": 500,
      "command_claim_timeout_ms": 10000,
      "dispatch_timeout_ms": 5000,
      "dispatch_max_retries": 3,
      "cancel_open_orders_at_session_end": true
    },
    "exit": {
      "enabled": false,
      "stop_loss_ratio": 0.03,
      "take_profit_ratio": 0.06,
      "max_holding_trade_days": 20,
      "monitor_interval_seconds": 30,
      "sell_limit_discount_ratio": 0.002
    },
    "bridge": {
      "base_url": "https://win-trade-01:8111",
      "callback_url": "http://127.0.0.1:18081/internal/v1/trading/bridge-events",
      "health_path": "/healthz",
      "request_timeout_ms": 5000,
      "expected_account_id": "",
      "strategy_id": "",
      "simulation_only": true,
      "hmac": {
        "key_id": "bridge-key-01",
        "secret": "",
        "max_clock_skew_seconds": 60,
        "nonce_ttl_seconds": 300
      },
      "tls": {
        "verify": true,
        "ca_file": "conf/finance-sys-bridge-ca.pem",
        "cert_file": "conf/bridge-cert.pem",
        "key_file": "conf/bridge-key.pem"
      }
    },
    "eastmoney": {
      "token": "",
      "strategy_id": "",
      "expected_account_id": "",
      "mode": "MODE_LIVE",
      "max_subscribed_symbols": 45,
      "sqlite_path": "data/bridge.db",
      "token_health": {
        "probe_interval_seconds": 60,
        "transient_failure_threshold": 2,
        "invalid_token_error_codes": [1000],
        "auth_service_error_codes": [1025, 1026],
        "kill_on_invalid_token": true,
        "require_restart_after_rotation": true
      },
      "historical_data": {
        "bulk_backfill_enabled": false,
        "max_records_per_request": 33000,
        "max_wait_time_seconds": 10,
        "local_cache_enabled": true,
        "provider_daily_quota_verified": false
      },
      "account_policy": {
        "max_active_accounts": 1,
        "allowed_account_ids": [],
        "verified_boards": ["SH_MAIN"],
        "provider_account_limit_verified": false,
        "max_simulation_strategies_per_account": 10
      }
    },
    "reconciliation": {
      "enabled": false,
      "interval_seconds": 60,
      "refresh_timeout_seconds": 10,
      "auto_repair_missing_events": true,
      "auto_repair_missing_fills": true,
      "kill_on_money_or_position_diff": true
    },
    "scheduler": {
      "enabled": false,
      "preflight": {"enabled": false, "hour": 8, "minute": 50},
      "pre_open_decision": {"enabled": false, "hour": 9, "minute": 20},
      "morning_window": {"start": "09:35:00", "end": "11:25:00"},
      "afternoon_window": {"start": "13:05:00", "end": "14:50:00"},
      "morning_cancel": {"enabled": false, "hour": 11, "minute": 25},
      "afternoon_cancel": {"enabled": false, "hour": 14, "minute": 50},
      "end_of_day_reconcile": {"enabled": false, "hour": 15, "minute": 10}
    }
  },
  "rules": {
    "version": "rules-v2",
    "strategy": "TEXT_REFERENCE_PRICE",
    "trade_date_offset_days": 1,
    "max_position_pct": 0.15,
    "default_stop_loss_pct": 0.03,
    "default_take_profit_pct": 0.06,
    "min_confidence": 0.65
  }
}
