# Copy this file to the ignored bootstrap_go122.env and set your Nacos address.
# This loopback value is an example, not a shared production endpoint.
NACOS_SERVER_ADDR=127.0.0.1:8848

# Code defaults: namespace=public, group=DEFAULT_GROUP, dataId=expert_trade.
# All business/runtime configuration, including the HTTP port, lives in Nacos.
# FINANCE_SYS_ENV is intentionally absent: empty/non-PROD uses database_test.
# Set FINANCE_SYS_ENV=PROD in the process environment only for production runs.
